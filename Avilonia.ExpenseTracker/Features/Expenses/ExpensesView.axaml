<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Avilonia.ExpenseTracker.Features.Expenses"
             xmlns:conv="using:Avilonia.ExpenseTracker.Common.Converters"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Avilonia.ExpenseTracker.Features.Expenses.ExpensesView"
             x:DataType="vm:ExpensesViewModel">

    <UserControl.Resources>
        <conv:MmkCurrencyConverter x:Key="MmkConv"/>
        <conv:AppDateFormatConverter x:Key="DateFormatConv"/>
        <conv:CategoryDisplayConverter x:Key="CatDisplayConv"/>
        <conv:CategoryColorConverter x:Key="CatColorConv"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20" Margin="24">

            <!-- Header Row -->
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding L[NavExpenses]}"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding FilteredExpenses.Count, StringFormat='{}{0} items'}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="•" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding FilteredTotalAmount, Converter={StaticResource MmkConv}, ConverterParameter='Total: '}"
                                   FontWeight="SemiBold"
                                   Foreground="#DC2626"/>
                    </StackPanel>
                </StackPanel>

                <Button Command="{Binding AddExpenseCommand}"
                        Classes="danger"
                        Padding="18,10"
                        CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconPlus}" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding L[AddExpense]}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Search, Filter & Sort Controls Card -->
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16">
                <Grid RowDefinitions="Auto" ColumnDefinitions="2*,1.2*,1.1*,1.1*,1.4*,Auto">
                    <!-- Search Input -->
                    <TextBox Grid.Column="0"
                             Text="{Binding SearchText, Mode=TwoWay}"
                             PlaceholderText="{Binding L[SearchExpensesPlaceholder]}"
                             Padding="12,8"
                             CornerRadius="8"
                             Margin="0,0,8,0"/>

                    <!-- Category Filter DropDown -->
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailableCategoryFilters}"
                              SelectedItem="{Binding SelectedCategoryFilter, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"
                              CornerRadius="8"
                              Padding="10,8"
                              Margin="0,0,8,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource CatDisplayConv}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- From Date -->
                    <DatePicker Grid.Column="2"
                                SelectedDate="{Binding StartDateFilter, Mode=TwoWay}"
                                DayFormat="d" MonthFormat="MM" YearFormat="yyyy"
                                HorizontalAlignment="Stretch"
                                CornerRadius="8"
                                Margin="0,0,8,0"/>

                    <!-- To Date -->
                    <DatePicker Grid.Column="3"
                                SelectedDate="{Binding EndDateFilter, Mode=TwoWay}"
                                DayFormat="d" MonthFormat="MM" YearFormat="yyyy"
                                HorizontalAlignment="Stretch"
                                CornerRadius="8"
                                Margin="0,0,8,0"/>

                    <!-- Sort Order Dropdown -->
                    <ComboBox Grid.Column="4"
                              ItemsSource="{Binding AvailableSortOrders}"
                              SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"
                              CornerRadius="8"
                              Padding="10,8"
                              Margin="0,0,8,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Clear Filter Button -->
                    <Button Grid.Column="5"
                            Content="{Binding L[ClearFilters]}"
                            Command="{Binding ClearFiltersCommand}"
                            Classes="secondary"
                            Padding="14,8"
                            CornerRadius="8"/>
                </Grid>
            </Border>

            <!-- Expense List Table -->
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16"
                    IsVisible="{Binding HasExpenses}">
                <StackPanel Spacing="10">
                    <!-- Table Header -->
                    <Grid ColumnDefinitions="3*,2*,1.5*,2*,2.2*" Margin="12,6,12,6">
                        <TextBlock Grid.Column="0" Text="{Binding L[Title]}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding L[Category]}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="2" Text="{Binding L[Date]}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="3" Text="{Binding L[Amount]}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="4" Text="{Binding L[Actions]}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                    </Grid>

                    <Separator Background="{DynamicResource BorderBrush}" Height="1"/>

                    <!-- Items Rows -->
                    <ItemsControl ItemsSource="{Binding FilteredExpenses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SubBackgroundBrush}"
                                        CornerRadius="8"
                                        Padding="12,10"
                                        Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="3*,2*,1.5*,2*,2.2*">
                                        <!-- Title & Note snippet -->
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Note}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </StackPanel>

                                        <!-- Category Badge with Luxury Dot -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Border Width="10" Height="10" CornerRadius="5"
                                                    Background="{Binding Category, Converter={StaticResource CatColorConv}}"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Category, Converter={StaticResource CatDisplayConv}}"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Date (dd-MM-yyyy) -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Date, Converter={StaticResource DateFormatConv}}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>

                                        <!-- Amount (MMK) -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Amount, Converter={StaticResource MmkConv}, ConverterParameter='- '}"
                                                   FontWeight="SemiBold"
                                                   Foreground="#DC2626"
                                                   VerticalAlignment="Center"/>

                                        <!-- Action Buttons: Details, Edit, Delete -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                                            <Button ToolTip.Tip="{Binding $parent[UserControl].((vm:ExpensesViewModel)DataContext).L[ExpenseDetails]}"
                                                    Command="{Binding $parent[UserControl].((vm:ExpensesViewModel)DataContext).ViewDetailsCommand}"
                                                    CommandParameter="{Binding}"
                                                    Classes="secondary"
                                                    Padding="8,6"
                                                    CornerRadius="6">
                                                <PathIcon Data="{StaticResource IconInfo}" Width="13" Height="13"
                                                          Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Button>
                                            <Button ToolTip.Tip="{Binding $parent[UserControl].((vm:ExpensesViewModel)DataContext).L[Edit]}"
                                                    Command="{Binding $parent[UserControl].((vm:ExpensesViewModel)DataContext).EditExpenseCommand}"
                                                    CommandParameter="{Binding}"
                                                    Classes="secondary"
                                                    Padding="8,6"
                                                    CornerRadius="6">
                                                <PathIcon Data="{StaticResource IconEdit}" Width="13" Height="13"
                                                          Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Button>
                                            <Button ToolTip.Tip="{Binding $parent[UserControl].((vm:ExpensesViewModel)DataContext).L[Delete]}"
                                                    Command="{Binding $parent[UserControl].((vm:ExpensesViewModel)DataContext).DeleteExpenseCommand}"
                                                    CommandParameter="{Binding}"
                                                    Classes="danger"
                                                    Padding="8,6"
                                                    CornerRadius="6">
                                                <PathIcon Data="{StaticResource IconTrash}" Width="13" Height="13"
                                                          Foreground="White"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Empty State -->
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="48"
                    IsVisible="{Binding !HasExpenses}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                    <Border Width="64" Height="64" CornerRadius="32" Background="#FEE2E2" HorizontalAlignment="Center">
                        <PathIcon Data="{StaticResource IconExpensesDown}" Width="24" Height="24"
                                  Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding L[NoExpensesFound]}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                    <Button Command="{Binding AddExpenseCommand}"
                            Classes="danger"
                            Padding="20,10"
                            CornerRadius="8"
                            HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconPlus}" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding L[AddExpense]}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
