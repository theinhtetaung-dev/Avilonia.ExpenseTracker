<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Avilonia.ExpenseTracker.Features.Expenses"
             xmlns:conv="using:Avilonia.ExpenseTracker.Common.Converters"
             mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="550"
             x:Class="Avilonia.ExpenseTracker.Features.Expenses.ExpenseDialogView"
             x:DataType="vm:ExpenseDialogViewModel">

    <UserControl.Resources>
        <conv:CategoryDisplayConverter x:Key="CatDisplayConv"/>
    </UserControl.Resources>

    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="28"
            Width="480"
            MaxHeight="620"
            BoxShadow="0 10 30 0 #40000000">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Header: Title Header & Error Banner -->
            <StackPanel Grid.Row="0" Spacing="14" Margin="0,0,0,16">
                <TextBlock Text="{Binding DialogTitle}"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                <!-- Error Message Banner -->
                <Border Background="#FEE2E2"
                        BorderBrush="#F87171"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,8"
                        IsVisible="{Binding HasError}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#B91C1C"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>

            <!-- Scrollable Body: Form Inputs -->
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Margin="0,0,0,16">
                <StackPanel Spacing="16">
                    <!-- Title Input -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding L[Title]}"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox Text="{Binding Title, Mode=TwoWay}"
                                 PlaceholderText="{Binding L[EnterTitlePlaceholder]}"
                                 Padding="12,10"
                                 CornerRadius="8"/>
                    </StackPanel>

                    <!-- Amount Input (MMK) -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding L[Amount]}"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox Text="{Binding AmountText, Mode=TwoWay}"
                                 PlaceholderText="{Binding L[EnterAmountPlaceholder]}"
                                 Padding="12,10"
                                 CornerRadius="8"/>
                    </StackPanel>

                    <!-- Category ComboBox -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding L[Category]}"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ComboBox ItemsSource="{Binding AvailableCategories}"
                                  SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  CornerRadius="8"
                                  Padding="12,8">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource CatDisplayConv}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Date Picker (dd-MM-yyyy format) -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding L[Date]}"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                    DayFormat="d"
                                    MonthFormat="MM"
                                    YearFormat="yyyy"
                                    HorizontalAlignment="Stretch"
                                    CornerRadius="8"/>
                    </StackPanel>

                    <!-- Note Input -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding L[Note]}"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox Text="{Binding Note, Mode=TwoWay}"
                                 PlaceholderText="{Binding L[EnterNotePlaceholder]}"
                                 AcceptsReturn="True"
                                 Height="70"
                                 TextWrapping="Wrap"
                                 Padding="12,8"
                                 CornerRadius="8"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Action Buttons Footer -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="12">
                <Button Content="{Binding L[Cancel]}"
                        Command="{Binding CancelCommand}"
                        Classes="secondary"
                        Padding="18,10"
                        CornerRadius="8"/>
                <Button Content="{Binding L[Save]}"
                        Command="{Binding SaveCommand}"
                        Classes="primary"
                        Padding="24,10"
                        CornerRadius="8"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
