<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Avilonia.ExpenseTracker.Features.Reports"
             xmlns:conv="using:Avilonia.ExpenseTracker.Common.Converters"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="750"
             x:Class="Avilonia.ExpenseTracker.Features.Reports.ReportsView"
             x:DataType="vm:ReportsViewModel">

    <UserControl.Resources>
        <conv:MmkCurrencyConverter x:Key="MmkConv"/>
        <conv:AppDateFormatConverter x:Key="DateFormatConv"/>
        <conv:CategoryDisplayConverter x:Key="CatDisplayConv"/>
        <conv:CategoryColorConverter x:Key="CatColorConv"/>
        <conv:IsPositiveColorConverter x:Key="PositiveColorConv"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="24" Margin="24">

            <!-- Page Title -->
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding L[ReportsTitle]}"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding TotalTransactions, StringFormat='{}Total Transactions: {0}'}"
                           FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>

            <!-- Metrics Overview Grid -->
            <Grid ColumnDefinitions="*,*,*,*" Margin="0,4,0,0">
                <!-- Total Balance -->
                <Border Grid.Column="0" Margin="0,0,10,0"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding L[CurrentBalance]}"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding Balance, Converter={StaticResource MmkConv}}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{Binding Balance, Converter={StaticResource PositiveColorConv}}"/>
                    </StackPanel>
                </Border>

                <!-- Total Income -->
                <Border Grid.Column="1" Margin="6,0,6,0"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding L[TotalIncome]}"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalIncome, Converter={StaticResource MmkConv}, ConverterParameter='+ '}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#16A34A"/>
                    </StackPanel>
                </Border>

                <!-- Total Expense -->
                <Border Grid.Column="2" Margin="6,0,6,0"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding L[TotalSpending]}"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalExpense, Converter={StaticResource MmkConv}, ConverterParameter='- '}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#DC2626"/>
                    </StackPanel>
                </Border>

                <!-- Average Expense -->
                <Border Grid.Column="3" Margin="10,0,0,0"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding L[AverageExpense]}"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding AverageExpense, Converter={StaticResource MmkConv}}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Highest Expense Banner Card with Luxury Vector Trophy Icon -->
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20"
                    IsVisible="{Binding HasHighestExpense}">
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <Border Width="48" Height="48" CornerRadius="12" Background="#FEF2F2" Margin="0,0,16,0">
                        <PathIcon Data="{StaticResource IconTrophy}" Width="20" Height="20"
                                  Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding L[HighestExpense]}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding HighestExpense.Title}"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding HighestExpense.Category, Converter={StaticResource CatDisplayConv}}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="•" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding HighestExpense.Date, Converter={StaticResource DateFormatConv}}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               Text="{Binding HighestExpense.Amount, Converter={StaticResource MmkConv}, ConverterParameter='- '}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#DC2626"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Two Columns: Category Breakdown & Recent Spending -->
            <Grid ColumnDefinitions="1.2*,*">
                <!-- Category Breakdown Card -->
                <Border Grid.Column="0" Margin="0,0,12,0"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{Binding L[CategoryBreakdown]}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <ItemsControl ItemsSource="{Binding CategoryBreakdown}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="6" Margin="0,6,0,8">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                            <Border Width="10" Height="10" CornerRadius="5"
                                                    Background="{Binding ColorHex}"
                                                    Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="Medium" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Amount, Converter={StaticResource MmkConv}}" FontWeight="SemiBold" Margin="0,0,12,0"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Percentage, StringFormat='{}{0}%'}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding PercentageRatio}"
                                                     Minimum="0" Maximum="1"
                                                     Height="6"
                                                     CornerRadius="3"
                                                     Foreground="#3B82F6"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Recent Spending Card -->
                <Border Grid.Column="1" Margin="12,0,0,0"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{Binding L[RecentSpending]}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <ItemsControl ItemsSource="{Binding RecentSpending}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SubBackgroundBrush}"
                                            CornerRadius="8"
                                            Padding="12,10"
                                            Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <!-- Luxury Colored Indicator -->
                                            <Border Width="10" Height="10" CornerRadius="5"
                                                    Background="{Binding Category, Converter={StaticResource CatColorConv}}"
                                                    Margin="0,0,12,0"
                                                    VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Date, Converter={StaticResource DateFormatConv}}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Amount, Converter={StaticResource MmkConv}, ConverterParameter='- '}"
                                                       FontWeight="SemiBold"
                                                       Foreground="#DC2626"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
