<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Avilonia.ExpenseTracker.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="Avilonia.ExpenseTracker.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding L[AppTitle]}"
        FontFamily="Segoe UI, Myanmar Text, Noto Sans Myanmar, Inter, Arial, sans-serif"
        Width="1200" Height="800"
        MinWidth="1050" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">

    <Grid>
        <!-- Main Application Layout: Sidebar + Content -->
        <Grid ColumnDefinitions="250,*">

            <!-- Sidebar Navigation -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="16,20">
                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- App Logo and Brand -->
                    <StackPanel Grid.Row="0" Spacing="14" Margin="0,0,0,24">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentBrush}">
                                <PathIcon Data="{StaticResource IconBrand}"
                                          Foreground="White"
                                          Width="20" Height="20"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding L[AppTitle]}"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <Border Background="{DynamicResource SubBackgroundBrush}"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="MVP • In-Memory"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <Separator Background="{DynamicResource BorderBrush}" Height="1"/>
                    </StackPanel>

                    <!-- Navigation Items List with Luxury Vector Icons -->
                    <StackPanel Grid.Row="1" Spacing="6">
                        <!-- Dashboard -->
                        <Button Classes="nav"
                                Command="{Binding NavigateToDashboardCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{StaticResource IconDashboard}" Width="18" Height="18"
                                          Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding L[NavDashboard]}"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Expenses -->
                        <Button Classes="nav"
                                Command="{Binding NavigateToExpensesCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{StaticResource IconExpensesDown}" Width="18" Height="18"
                                          Foreground="#DC2626" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding L[NavExpenses]}"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Income -->
                        <Button Classes="nav"
                                Command="{Binding NavigateToIncomeCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{StaticResource IconIncome}" Width="18" Height="18"
                                          Foreground="#16A34A" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding L[NavIncome]}"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Categories -->
                        <Button Classes="nav"
                                Command="{Binding NavigateToCategoriesCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{StaticResource IconCategories}" Width="18" Height="18"
                                          Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding L[NavCategories]}"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Reports -->
                        <Button Classes="nav"
                                Command="{Binding NavigateToReportsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{StaticResource IconReports}" Width="18" Height="18"
                                          Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding L[NavReports]}"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Settings -->
                        <Button Classes="nav"
                                Command="{Binding NavigateToSettingsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{StaticResource IconSettings}" Width="18" Height="18"
                                          Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding L[NavSettings]}"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Sidebar Footer: Theme Switcher & Currency Indicator -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource SubBackgroundBrush}"
                            CornerRadius="10"
                            Padding="12,10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="MMK Currency"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="dd-MM-yyyy"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Command="{Binding ToggleThemeCommand}"
                                    Classes="secondary"
                                    Width="36" Height="36"
                                    Padding="0"
                                    CornerRadius="18"
                                    ToolTip.Tip="Toggle Light/Dark Theme">
                                <PathIcon Data="{StaticResource IconThemeToggle}" Width="16" Height="16"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <ContentControl Grid.Column="1"
                            Content="{Binding CurrentPage}"
                            Background="{DynamicResource AppBackgroundBrush}"/>
        </Grid>

        <!-- Centered Modal Overlay -->
        <Grid IsVisible="{Binding IsModalOpen}">
            <!-- Darkened background scrim -->
            <Border Background="#80000000"/>

            <!-- Centered Modal Dialog Card -->
            <ContentControl Content="{Binding ActiveModal}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
